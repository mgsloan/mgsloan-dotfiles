[Unit]
Description=Apply the CPU governor/power profile (auto by AC status, or the M-x override)
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service
# Apply after waking, including a charger change while asleep.
After=systemd-suspend.service systemd-hibernate.service systemd-hybrid-sleep.service systemd-suspend-then-hibernate.service

[Service]
Type=oneshot
ExecStart=/home/mgsloan/env/system/scripts/cpu-governor-apply.sh
TimeoutStartSec=15s

[Install]
# power-profiles-daemon runs after multi-user.target; this must not hold it up.
WantedBy=graphical.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
