diff --git a/river/KeystrokeHistograms.zig b/river/KeystrokeHistograms.zig
new file mode 100644
index 0000000..52be789
--- /dev/null
+++ b/river/KeystrokeHistograms.zig
@@ -0,0 +1,214 @@
+// SPDX-FileCopyrightText: © 2026 The River Developers
+// SPDX-License-Identifier: GPL-3.0-only
+
+const KeystrokeHistograms = @This();
+
+const std = @import("std");
+const Io = std.Io;
+const posix = std.posix;
+const wl = @import("wayland").server.wl;
+
+const c = @import("c");
+const util = @import("util.zig");
+
+const log = std.log.scoped(.input);
+const io = Io.Threaded.global_single_threaded.io();
+
+const key_count = c.KEY_MAX + 1;
+
+directory: ?Io.Dir = null,
+timer: ?*wl.EventSource = null,
+minute: i64 = 0,
+programs: std.StringArrayHashMapUnmanaged(u64) = .empty,
+keys: [key_count]u64 = @splat(0),
+keys_dirty: bool = false,
+
+pub fn init(histograms: *KeystrokeHistograms, path: []const u8) !void {
+    const directory = try Io.Dir.cwd().createDirPathOpen(io, path, .{
+        .permissions = .fromMode(0o700),
+    });
+    errdefer directory.close(io);
+
+    histograms.directory = directory;
+    errdefer histograms.directory = null;
+    histograms.loadKeys() catch |err| switch (err) {
+        error.FileNotFound => {},
+        else => return err,
+    };
+    histograms.minute = currentMinute();
+    histograms.timer = try @import("main.zig").server.wl_server.getEventLoop().addTimer(
+        *KeystrokeHistograms,
+        handleTimer,
+        histograms,
+    );
+    histograms.scheduleTimer();
+}
+
+pub fn deinit(histograms: *KeystrokeHistograms) void {
+    if (histograms.directory == null) return;
+
+    histograms.flush();
+    histograms.timer.?.remove();
+    histograms.clearPrograms();
+    histograms.programs.deinit(util.gpa);
+    histograms.directory.?.close(io);
+    histograms.* = .{};
+}
+
+/// Record one non-virtual key press. A null app ID means no program received it.
+pub fn record(histograms: *KeystrokeHistograms, keycode: u32, app_id: ?[]const u8) void {
+    if (histograms.directory == null) return;
+
+    const minute = currentMinute();
+    if (minute != histograms.minute) histograms.advance(minute);
+
+    if (keycode < histograms.keys.len) {
+        const count = &histograms.keys[keycode];
+        count.* = std.math.add(u64, count.*, 1) catch std.math.maxInt(u64);
+        histograms.keys_dirty = true;
+    }
+
+    const program = app_id orelse return;
+    const entry = histograms.programs.getOrPut(util.gpa, program) catch {
+        log.err("out of memory recording keystroke program", .{});
+        return;
+    };
+    if (!entry.found_existing) {
+        entry.key_ptr.* = util.gpa.dupe(u8, program) catch {
+            _ = histograms.programs.swapRemove(program);
+            log.err("out of memory recording keystroke program", .{});
+            return;
+        };
+        entry.value_ptr.* = 0;
+    }
+    entry.value_ptr.* = std.math.add(u64, entry.value_ptr.*, 1) catch std.math.maxInt(u64);
+}
+
+fn advance(histograms: *KeystrokeHistograms, minute: i64) void {
+    histograms.flush();
+    histograms.clearPrograms();
+    histograms.minute = minute;
+}
+
+fn flush(histograms: *KeystrokeHistograms) void {
+    if (histograms.programs.count() > 0) {
+        histograms.appendPrograms() catch |err| {
+            log.err("failed to save per-minute keystroke histogram: {s}", .{@errorName(err)});
+        };
+    }
+    if (histograms.keys_dirty) {
+        histograms.writeKeys() catch |err| {
+            log.err("failed to save cumulative keystroke histogram: {s}", .{@errorName(err)});
+            return;
+        };
+        histograms.keys_dirty = false;
+    }
+}
+
+fn appendPrograms(histograms: *KeystrokeHistograms) !void {
+    const directory = histograms.directory.?;
+    var file = try directory.createFile(io, "programs.tsv", .{
+        .truncate = false,
+        .permissions = .fromMode(0o600),
+    });
+    defer file.close(io);
+
+    var buffer: [4096]u8 = undefined;
+    var file_writer = file.writer(io, &buffer);
+    file_writer.pos = (try file.stat(io)).size;
+    const writer = &file_writer.interface;
+    for (histograms.programs.keys(), histograms.programs.values()) |program, count| {
+        try writer.print("{d}\t{d}\t", .{ histograms.minute * 60, count });
+        try writeTsvField(writer, program);
+        try writer.writeByte('\n');
+    }
+    try writer.flush();
+}
+
+fn writeKeys(histograms: *KeystrokeHistograms) !void {
+    var atomic_file = try histograms.directory.?.createFileAtomic(io, "keys.tsv", .{
+        .replace = true,
+        .permissions = .fromMode(0o600),
+    });
+    defer atomic_file.deinit(io);
+
+    var buffer: [4096]u8 = undefined;
+    var file_writer = atomic_file.file.writer(io, &buffer);
+    const writer = &file_writer.interface;
+    try writer.writeAll("# evdev_code\tkey\tcount\n");
+    for (histograms.keys, 0..) |count, keycode| {
+        if (count == 0) continue;
+        const name: ?[*:0]const u8 = c.libevdev_event_code_get_name(c.EV_KEY, @intCast(keycode));
+        try writer.print("{d}\t{s}\t{d}\n", .{
+            keycode,
+            if (name) |value| std.mem.span(value) else "UNKNOWN",
+            count,
+        });
+    }
+    try writer.flush();
+    try atomic_file.replace(io);
+}
+
+fn loadKeys(histograms: *KeystrokeHistograms) !void {
+    const contents = try histograms.directory.?.readFileAlloc(
+        io,
+        "keys.tsv",
+        util.gpa,
+        .limited(1024 * 1024),
+    );
+    defer util.gpa.free(contents);
+
+    var lines = std.mem.splitScalar(u8, contents, '\n');
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        var fields = std.mem.splitScalar(u8, line, '\t');
+        const keycode = try std.fmt.parseUnsigned(usize, fields.next() orelse return error.InvalidData, 10);
+        _ = fields.next() orelse return error.InvalidData;
+        const count = try std.fmt.parseUnsigned(u64, fields.next() orelse return error.InvalidData, 10);
+        if (keycode >= histograms.keys.len or fields.next() != null) return error.InvalidData;
+        histograms.keys[keycode] = count;
+    }
+}
+
+fn clearPrograms(histograms: *KeystrokeHistograms) void {
+    for (histograms.programs.keys()) |program| util.gpa.free(program);
+    histograms.programs.clearRetainingCapacity();
+}
+
+fn handleTimer(histograms: *KeystrokeHistograms) c_int {
+    histograms.advance(currentMinute());
+    histograms.scheduleTimer();
+    return 0;
+}
+
+fn scheduleTimer(histograms: *KeystrokeHistograms) void {
+    var now: posix.timespec = undefined;
+    switch (posix.errno(posix.system.clock_gettime(posix.CLOCK.REALTIME, &now))) {
+        .SUCCESS => {},
+        else => unreachable,
+    }
+    const elapsed_ms = @mod(now.sec, 60) * std.time.ms_per_s +
+        @divTrunc(now.nsec, std.time.ns_per_ms);
+    const delay_ms: u31 = @intCast(60 * std.time.ms_per_s - elapsed_ms);
+    histograms.timer.?.timerUpdate(delay_ms) catch |err| {
+        log.err("failed to schedule keystroke histogram flush: {s}", .{@errorName(err)});
+    };
+}
+
+fn currentMinute() i64 {
+    var now: posix.timespec = undefined;
+    switch (posix.errno(posix.system.clock_gettime(posix.CLOCK.REALTIME, &now))) {
+        .SUCCESS => return @divFloor(now.sec, 60),
+        else => unreachable,
+    }
+}
+
+fn writeTsvField(writer: *Io.Writer, field: []const u8) !void {
+    for (field) |byte| switch (byte) {
+        '\\' => try writer.writeAll("\\\\"),
+        '\t' => try writer.writeAll("\\t"),
+        '\n' => try writer.writeAll("\\n"),
+        '\r' => try writer.writeAll("\\r"),
+        else => try writer.writeByte(byte),
+    };
+}
