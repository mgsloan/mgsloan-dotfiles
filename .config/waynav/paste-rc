# waynav config for a single middle click at the pointer -- keynav's
# "mod4+v toggle-start,cursorzoom 1 1,click 2,end".  Launched by M-v in the
# river build of the xmonad config (~/env/src/xmonad.hs).
#
# The commands run at startup come from the "start" line, not from the key it
# names, so a second entry point means a second config rather than another
# binding in waynavrc.

clear

# The 1x1 cursorzoom shrinks the region onto the pointer, so the warp that
# follows leaves the pointer where it already was and click 2 lands there.
super+v start,cursorzoom 1 1,warp,click 2,end

# The "end" above now takes effect, so no overlay is ever drawn and no key is
# ever waited on -- waynav exits in about 20ms.  Escape is kept as a way out
# in case a future change puts the overlay back on screen.
Escape end
