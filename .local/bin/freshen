#!/bin/bash
set -euo pipefail

# Refresh software without running setup scripts.
if [ "$UID" -eq 0 ]; then
  echo "Run freshen as yourself; system operations use sudo." >&2
  exit 1
fi

printf '\nFreshening APT packages:\n\n'
package_list=$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$HOME/env/apt-packages.md")
sudo apt-get update
if [[ -n $package_list ]]; then
  mapfile -t packages <<< "$package_list"
  sudo apt-get install --yes "${packages[@]}"
fi
sudo apt-get upgrade --yes

if [ -x "$HOME/ep/freshen.sh" ]; then
  "$HOME/ep/freshen.sh"
fi

printf '\nFreshening Nix packages:\n\n'
"$HOME/env/nix/scripts/freshen-nix.sh"
