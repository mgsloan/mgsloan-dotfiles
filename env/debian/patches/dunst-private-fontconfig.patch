Author: Michael Sloan <mgsloan@gmail.com>
Forwarded: not-needed

--- a/src/draw.c
+++ b/src/draw.c
@@ -1,3 +1,4 @@
+#include "../private-fontconfig.h"
 /* SPDX-License-Identifier: BSD-3-Clause */
 /**
  * @file
@@ -152,7 +153,7 @@
 
