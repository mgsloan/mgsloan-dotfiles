# A far more concise way of doing this would be something like
#
#  # Ignore all sub-dirs. More generic approach
#  /*/
#  # Un-ignore some sub-dirs.
#  !/env/
#
# However, instead, to aid in keeping track of what makes it into the
# home dir, things are ignored selectively. The bulk of these are in
# ~/env-private/home.gitignore

# Generic transient and security-sensitive home files
-*~
__pycache__/
/.bash_history*
/.cache/
/.gitconfig
/.gnupg/
/.home.git/
/.local/share/
/.local/state/
/.ssh/
/.sudo_as_admin_successful
/.wget-hsts

# State generated by publicly tracked configuration
/.cargo/
/.config/alacritty/alacritty.toml
/.config/dconf
/.config/gh/hosts.yml
/.config/ghostty/theme
/.config/go/telemetry
/.config/herdr/.plugins.lock
/.config/herdr/*.log
/.config/herdr/release-notes.json
/.config/herdr/session.json
/.config/herdr/sessions/
/.config/htop/htop_history
/.config/spotify/
/.config/systemd/user/default.target.wants/
/.config/user-dirs.locale
/.emacs.d/
/.nix-defexpr/
/.rustup/
