name:           xmonad-river-contrib
version:        0.1.0
synopsis:       xmonad-contrib modules reimplemented against river
description:    The counterpart of @xmonad-contrib@ for @xmonad-river@: the community
                modules a configuration imports, reimplemented over river's window
                management protocol.
                .
                Split out from @xmonad-river@ for the same reason upstream splits them —
                the core protocol layer should not have to change when a contrib module
                does, and configs depend on a stable core with a churnier contrib.
author:         Michael Sloan
maintainer:     Michael Sloan
license:        BSD3
license-file:   LICENSE
build-type:     Simple

library
  exposed-modules:
      XMonad.Actions.CycleWS
      XMonad.Actions.DwmPromote
      XMonad.Actions.FlexibleManipulate
      XMonad.Actions.PhysicalScreens
      XMonad.Actions.Warp
      XMonad.Actions.WithAll
      XMonad.Config.Gnome
      XMonad.Hooks.EwmhDesktops
      XMonad.Hooks.ManageHelpers
      XMonad.Hooks.UrgencyHook
      XMonad.Layout.FocusTracking
      XMonad.Prompt
      XMonad.Prompt.Shell
      XMonad.Util.Cursor
      XMonad.Util.ExtensibleState
      XMonad.Util.EZConfig
      XMonad.Util.SessionStart
  other-modules:
      Paths_xmonad_river_contrib
  hs-source-dirs:
      src
  default-extensions:
      FlexibleContexts
      FlexibleInstances
      LambdaCase
      MultiParamTypeClasses
      RankNTypes
      ScopedTypeVariables
      TupleSections
      TypeApplications
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  build-depends:
      base
